# Copy this file to .env and set unique values before starting the API.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pgmanagement
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the generated key here. Leave blank only when SMTP credential encryption is not used.
ENCRYPTION_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true
